---
import BaseHead from '../components/global/BaseHead.astro';
import StructuredData from '../components/global/StructuredData.astro';
import type { AppContent } from '../types/app';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  openGraph?: Record<string, any>;
  /** Pass an app's content module to add its JSON-LD node (Person is always emitted). */
  structuredDataApp?: AppContent;
}
---

<html
  lang='en'
  class='scroll-smooth selection:bg-gray-900 selection:text-white overflow-x-hidden'
>
  <head>
    <BaseHead
      title={Astro.props.title}
      description={Astro.props.description}
      canonical={Astro.props.canonical}
      openGraph={Astro.props.openGraph}
    />
    <StructuredData app={Astro.props.structuredDataApp} />
  </head>

  <body class='overflow-x-hidden bg-gray-900'>
    <slot />
  </body>
</html>
