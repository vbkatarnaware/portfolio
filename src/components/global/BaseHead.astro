---
import '../../styles/global.css';
import { AstroSeo } from '@astrolib/seo';
import { getImage } from 'astro:assets';
import customWallpaper from '../../assets/images/wallpaper4.png';

const backgrounds = await Promise.all([
  getImage({ src: customWallpaper, width: 3500 }),
]);
---

<!-- Core meta tags -->
<meta charset='UTF-8' />
<meta http-equiv='X-UA-Compatible' content='IE=edge' />
<meta
  name='viewport'
  content='width=device-width, initial-scale=1, maximum-scale=1'
/>
<meta name='author' content='Vipul Katarnaware' />

<!-- SEO Configuration -->
<AstroSeo
  title={Astro.props.title || 'Vipul Katarnaware — Product Manager'}
  description={Astro.props.description ||
    'Vipul Katarnaware is a Product Manager based in Navi Mumbai, India, with hands-on founder and enterprise experience across B2B SaaS, FinTech, and AI products.'}
  canonical={Astro.props.canonical || 'https://vipulkatarnaware.in'}
  openGraph={{
    type: 'website',
    url: Astro.props.openGraph?.url || 'https://vipulkatarnaware.in',
    title: Astro.props.openGraph?.title || 'Vipul Katarnaware — Product Manager',
    description:
      Astro.props.openGraph?.description ||
      'Vipul Katarnaware is a Product Manager based in Navi Mumbai, India, with hands-on founder and enterprise experience across B2B SaaS, FinTech, and AI products.',
    images: [
      {
        url: 'https://vipulkatarnaware.in/apple-touch-icon.png',
        width: 512,
        height: 512,
        alt: 'Vipul Katarnaware — Product Manager',
      },
    ],
    site_name: Astro.props.openGraph?.site_name || 'Vipul Katarnaware',
  }}
  twitter={{
    cardType: 'summary',
  }}
  additionalMetaTags={[
    { property: 'profile:first_name', content: 'Vipul' },
    { property: 'profile:last_name', content: 'Katarnaware' },
  ]}
/>

<link rel='icon' type='image/png' href='/favicon.png' />
<link rel='apple-touch-icon' href='/apple-touch-icon.png' />
<link rel='manifest' href='/site.webmanifest' />

<!-- Theme colors for browsers -->
<meta name='msapplication-TileColor' content='#0058d0' />
<meta name='theme-color' content='#0058d0' />

<!-- Auto-generated sitemap -->
<link rel='sitemap' href='/sitemap-index.xml' />

<!-- Preload background images for performance -->
{
  backgrounds.map((bg) => (
    <link
      rel='preload'
      href={bg.src}
      as='image'
      type='image/webp'
      fetchpriority='high'
    />
  ))
}
