---
import type {
  AppContent,
  ProblemDefinition,
  ArchitectureDetails,
} from '../../types/app';

interface Props {
  content: AppContent;
}

const { content } = Astro.props;

// A section field may be a non-empty array OR a populated structured object
// (ProblemDefinition, ArchitectureDetails, …). `.length` is `undefined` on an
// object, so a plain `field?.length` guard silently hides every structured
// section — this mirrors the same helper the interactive shell uses
// (AppShell.tsx) so the crawler-visible block never disagrees with what a
// sighted, JS-enabled visitor sees.
function hasData(value: unknown): boolean {
  if (value == null) return false;
  if (Array.isArray(value)) return value.length > 0;
  if (typeof value === 'object') return Object.keys(value).length > 0;
  return Boolean(value);
}

const isProblemArray = Array.isArray(content.problem);
const problemObj = (!isProblemArray ? content.problem : null) as ProblemDefinition | null;

const isArchArray = Array.isArray(content.architecture);
const archObj = (content.architecture && !isArchArray
  ? content.architecture
  : null) as ArchitectureDetails | null;
const archSteps = isArchArray ? (content.architecture as { label: string }[]) : null;
---

<!--
  Server-rendered content parity block. The interactive desktop (AppLayout,
  client:load) visually covers this once hydrated — but this real semantic
  HTML is what crawlers, AI search, and ATS parsers actually read, since the
  desktop's window content is otherwise invisible to them (client-rendered).
  Sourced from the same content.ts module the React shell uses — single
  source of truth, never duplicated by hand. Every field the interactive
  shell can show is exposed here in truthful, already-approved copy.
-->
<article class="sr-content" aria-hidden="true">
  <h1>{content.name}</h1>
  <p>{content.tagline}</p>
  {content.role && <p>{content.role}{content.dates ? ` · ${content.dates}` : ''}{content.location ? ` · ${content.location}` : ''}</p>}

  <h2>Overview</h2>
  {hasData(content.overview) && content.overview.map((p) => <p>{p}</p>)}
  {content.overviewSummary && (
    <dl>
      <dt>The Problem</dt>
      <dd>{content.overviewSummary.problem}</dd>
      <dt>The Solution</dt>
      <dd>{content.overviewSummary.solution}</dd>
      <dt>The Impact</dt>
      <dd>{content.overviewSummary.impact}</dd>
    </dl>
  )}

  {hasData(content.problem) && (
    <>
      <h2>{content.problemTitle}</h2>
      {isProblemArray
        ? (content.problem as string[]).map((p) => <p>{p}</p>)
        : problemObj && (
            <>
              <p>{problemObj.workflow}</p>
              <p>{problemObj.whyFailed}</p>
              {hasData(problemObj.painPoints) && (
                <ul>
                  {problemObj.painPoints.map((pp) => <li>{pp}</li>)}
                </ul>
              )}
              <p>{problemObj.opportunity}</p>
            </>
          )}
    </>
  )}

  {hasData(content.roleCards) && (
    <>
      <h2>Responsibilities</h2>
      <ul>
        {content.roleCards!.map((r) => <li>{r}</li>)}
      </ul>
    </>
  )}

  {hasData(content.discovery) && (
    <>
      <h2>Discovery &amp; Decisions</h2>
      {content.discovery.map((p) => <p>{p}</p>)}
    </>
  )}

  {content.customerResearch && (
    <>
      <h2>Customer Research</h2>
      <p>{content.customerResearch.hero.title}</p>
      <p>{content.customerResearch.hero.description}</p>
      {hasData(content.customerResearch.biggestDiscoveries) && (
        <ul>
          {content.customerResearch.biggestDiscoveries.map((d) => (
            <li><strong>{d.title}:</strong> {d.description} ({d.influencedDecision})</li>
          ))}
        </ul>
      )}
      {hasData(content.customerResearch.personas) && (
        <>
          <h3>Target Personas</h3>
          {content.customerResearch.personas.map((persona) => (
            <section>
              <h4>{persona.role}</h4>
              {hasData(persona.painPoints) && (
                <ul>{persona.painPoints.map((pp) => <li>{pp}</li>)}</ul>
              )}
            </section>
          ))}
        </>
      )}
    </>
  )}

  {content.technicalDiscovery && (
    <>
      <h2>Technical Discovery</h2>
      <p>{content.technicalDiscovery.initialObservation}</p>
      <p>{content.technicalDiscovery.investigation}</p>
      <p>{content.technicalDiscovery.rootCauseAnalysis}</p>
      <p>{content.technicalDiscovery.validation}</p>
      <p>{content.technicalDiscovery.finalInsight}</p>
    </>
  )}

  {hasData(content.decisionLog) && (
    <>
      <h2>Decision Log</h2>
      {content.decisionLog.map((d) => (
        <section>
          <h3>{d.decision}</h3>
          {d.summary && <p>{d.summary}</p>}
          <p><strong>Reason:</strong> {Array.isArray(d.reason) ? d.reason.join(' ') : d.reason}</p>
          {hasData(d.alternatives) && (
            <p><strong>Alternatives considered:</strong> {d.alternatives.join('; ')}</p>
          )}
          {hasData(d.rejectedBecause) && (
            <p><strong>Rejected because:</strong> {d.rejectedBecause.join('; ')}</p>
          )}
          <p><strong>Outcome:</strong> {d.outcome}</p>
          {hasData(d.impact) && (
            <p><strong>Impact:</strong> {d.impact.join('; ')}</p>
          )}
        </section>
      ))}
    </>
  )}

  {hasData(content.rejectedDecisions) && (
    <>
      <h2>Rejected Decisions</h2>
      <dl>
        {content.rejectedDecisions.map((r) => (
          <>
            <dt>{r.question}</dt>
            <dd>{r.answer}</dd>
          </>
        ))}
      </dl>
    </>
  )}

  {hasData(content.timeline) && (
    <>
      <h2>Timeline</h2>
      <ul>
        {content.timeline.map((t) => (
          <li>{t.date ? `${t.date} — ` : ''}{t.label}{t.description ? `: ${t.description}` : ''}</li>
        ))}
      </ul>
    </>
  )}

  {hasData(content.architecture) && (
    <>
      <h2>Architecture</h2>
      {archObj ? (
        <>
          <p>{archObj.overview}</p>
          {hasData(archObj.diagramSteps) && (
            <ol>{archObj.diagramSteps.map((s) => <li>{s.label}</li>)}</ol>
          )}
          {hasData(archObj.designPrinciples) && (
            <ul>{archObj.designPrinciples.map((p) => <li>{p}</li>)}</ul>
          )}
          <p>{archObj.whyThisArchitecture}</p>
          {hasData(archObj.majorTradeoffs) && (
            <dl>
              {archObj.majorTradeoffs.map((t) => (
                <>
                  <dt>{t.tradeoff}</dt>
                  <dd>{t.reason}</dd>
                </>
              ))}
            </dl>
          )}
        </>
      ) : archSteps && (
        <ol>{archSteps.map((s) => <li>{s.label}</li>)}</ol>
      )}
    </>
  )}

  {hasData(content.crossFunctional) && (
    <>
      <h2>Cross-functional Leadership</h2>
      <ul>{content.crossFunctional!.map((c) => <li>{c}</li>)}</ul>
    </>
  )}

  {hasData(content.decisionSystems) && (
    <>
      <h2>Decision Systems</h2>
      <ol>{content.decisionSystems!.map((s) => <li>{s.label}</li>)}</ol>
    </>
  )}

  {hasData(content.roadmap) && (
    <>
      <h2>Roadmap</h2>
      <dl>
        {content.roadmap!.map((r) => (
          <>
            <dt>{r.whatsNext}</dt>
            <dd>Why: {r.why} Why not now: {r.whyNotNow}</dd>
          </>
        ))}
      </dl>
    </>
  )}

  {hasData(content.highlights) && (
    <>
      <h2>Highlights</h2>
      <dl>
        {content.highlights.map((h) => (
          <>
            <dt>{h.label}</dt>
            <dd>{h.value}</dd>
          </>
        ))}
      </dl>
    </>
  )}

  {hasData(content.impact) && (
    <>
      <h2>Impact</h2>
      <dl>
        {content.impact!.map((i) => (
          <>
            <dt>{i.label}</dt>
            <dd>{i.value}</dd>
          </>
        ))}
      </dl>
    </>
  )}

  {content.lessonsLearned && (
    <>
      <h2>Lessons Learned</h2>
      <dl>
        <dt>Biggest lesson</dt>
        <dd>{content.lessonsLearned.biggestLesson}</dd>
        <dt>Mistake</dt>
        <dd>{content.lessonsLearned.mistake}</dd>
        <dt>What I'd do differently</dt>
        <dd>{content.lessonsLearned.differently}</dd>
        <dt>Principle</dt>
        <dd>{content.lessonsLearned.principle}</dd>
        <dt>Advice</dt>
        <dd>{content.lessonsLearned.advice}</dd>
      </dl>
    </>
  )}

  {hasData(content.lessons) && (
    <>
      <h2>Lessons Learned</h2>
      <ul>
        {content.lessons.map((l) => <li>{l}</li>)}
      </ul>
    </>
  )}

  {hasData(content.keyLearnings) && (
    <>
      <h2>Key Learnings</h2>
      <ul>
        {content.keyLearnings!.map((l) => <li>{l}</li>)}
      </ul>
    </>
  )}

  {content.externalUrl && (
    <p><a href={content.externalUrl}>Visit {content.name}</a></p>
  )}
  {content.githubUrl && (
    <p><a href={content.githubUrl}>{content.name} on GitHub</a></p>
  )}
</article>

<style>
  /* Visually beneath the desktop once hydrated, but present in the DOM for
     any client that doesn't render the interactive layer. */
  .sr-content {
    position: absolute;
    inset: 0;
    max-width: 70ch;
    margin: 0 auto;
    padding: 2rem;
    color: rgba(255, 255, 255, 0.7);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    z-index: 0;
  }
</style>
