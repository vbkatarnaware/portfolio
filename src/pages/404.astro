---
import Layout from '../layouts/Layout.astro';

// Minimal, unstyled-beyond-the-shared-dark-theme 404 — no new design system,
// just enough for a lost visitor/crawler to get back to a real page. noindex
// so this URL (and whatever bad path led here) never gets indexed itself.
---

<Layout
  title="Page Not Found — Vipul Katarnaware"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <main class="min-h-screen flex flex-col items-center justify-center text-center px-6 bg-gray-900 text-white">
    <h1 class="text-[15vw] sm:text-[8rem] font-semibold tracking-tight leading-none text-white/90">404</h1>
    <p class="mt-4 text-white/60 text-[15px] max-w-[40ch]">
      This page doesn't exist. It may have moved, or the link may be out of date.
    </p>
    <a
      href="/"
      class="mt-8 px-5 py-2.5 bg-[#0058d0] hover:bg-[#0058d0]/85 text-white text-[14px] font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-white/40 focus:ring-offset-2 focus:ring-offset-gray-900"
    >
      Back to Home
    </a>
  </main>
</Layout>
