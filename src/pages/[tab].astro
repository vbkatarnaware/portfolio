---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import AppLayout from '../layouts/AppLayout';
import customWallpaper from '../assets/images/wallpaper4.png';

export function getStaticPaths() {
  return [
    { params: { tab: 'about' } },
    { params: { tab: 'resume' } },
    { params: { tab: 'experience' } },
    { params: { tab: 'contact' } },
    { params: { tab: 'products' } }
  ];
}

const backgrounds = [customWallpaper];

function getRandomBackground() {
  return `bg-1`;
}

const optimizedBackgrounds = await Promise.all(
  backgrounds.map((bg) =>
    getImage({
      src: bg,
      width: 3500,
    })
  )
);

const backgroundMap = Object.fromEntries(
  optimizedBackgrounds.map((bg, index) => [`bg-${index + 1}`, bg.src])
);
---

<Layout
  title='Vipul Katarnaware — AI-Native Product Manager & Founder'
  description='Vipul Katarnaware is an AI-native Product Manager and founder based in Mumbai, building 0-to-1 products with agentic AI workflows across FinTech and B2B SaaS.'
  canonical='https://vipulkatarnaware.com'
  openGraph={{
    url: 'https://vipulkatarnaware.com',
    title: 'Vipul Katarnaware — AI-Native Product Manager & Founder',
    description:
      'Vipul Katarnaware is an AI-native Product Manager and founder based in Mumbai, building 0-to-1 products with agentic AI workflows across FinTech and B2B SaaS.',
    site_name: 'Vipul Katarnaware',
  }}
>
  <AppLayout
    client:load
    initialBg={getRandomBackground()}
    backgroundMap={backgroundMap}
  />
</Layout>
